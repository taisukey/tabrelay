#!/bin/zsh
# tabrelay — Brave の現在のタブ（タイトル / URL）を Muse へ渡す
#              Pass the current Brave tab (title / URL) to Muse.
# Copyright (c) 2026 taisukey. MIT License.
#
#   --list : Alfred Script Filter 用。副作用なし / for Alfred Script Filter, no side effects
#   --send : 依頼文をコピーして Quick Chat を開く / copy the prompt and open Quick Chat
#   --lang ja|en : 表示言語（環境変数 TABRELAY_LANG でも指定可、既定 ja）
#   モードは環境変数 TABRELAY_MODE でも指定可（公開パッケージの埋め込み用）
set -u

mode="${TABRELAY_MODE:---send}"
lang="${TABRELAY_LANG:-ja}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --list) mode="--list" ;;
    --send) mode="--send" ;;
    --lang) shift; lang="${1:-ja}" ;;
  esac
  shift
done

if [[ "$lang" == "en" ]]; then
  L_NOTAB="No Brave tab found"
  L_NOTAB_SUB="Open a page in Brave, then try again"
  L_PROMPT_HEAD="Please take a look at this page."
  L_TITLE="Title"
  L_COPIED="Copied. Paste into Muse to send"
else
  L_NOTAB="Brave のタブが取得できませんでした"
  L_NOTAB_SUB="Brave でページを開いてから実行してください"
  L_PROMPT_HEAD="このページを見てください。"
  L_TITLE="タイトル"
  L_COPIED="コピーしました。貼り付けて送信してください"
fi

get_title() { osascript -e 'tell application "Brave Browser" to get title of active tab of front window' 2>/dev/null; }
get_url()   { osascript -e 'tell application "Brave Browser" to get URL of active tab of front window' 2>/dev/null; }
json_escape() { python3 -c 'import json, sys; print(json.dumps(sys.stdin.read()))'; }

title=$(get_title)
url=$(get_url)

if [[ "$mode" == "--list" ]]; then
  if [[ -z "$url" ]]; then
    nt=$(printf '%s' "$L_NOTAB" | json_escape)
    ns=$(printf '%s' "$L_NOTAB_SUB" | json_escape)
    printf '{"items":[{"title":%s,"subtitle":%s,"valid":false}]}\n' "$nt" "$ns"
    exit 0
  fi
  t=$(printf '%s' "$title" | json_escape)
  u=$(printf '%s' "$url" | json_escape)
  printf '{"items":[{"title":%s,"subtitle":%s,"arg":%s,"valid":true}]}\n' "$t" "$u" "$u"
  exit 0
fi

# --send
if [[ -z "$url" ]]; then
  echo "$L_NOTAB"
  exit 1
fi
{
  echo "$L_PROMPT_HEAD"
  echo
  echo "$L_TITLE: $title"
  echo "URL: $url"
} | pbcopy
# Muse Quick Chat（Option+Space）を開く。アクセシビリティ許可が無い場合は静かに失敗する
# Open Muse Quick Chat (Option+Space). Fails silently without the Accessibility permission.
osascript -e 'tell application "System Events" to keystroke " " using {option down}' >/dev/null 2>&1 || true
echo "$L_COPIED: $title"
